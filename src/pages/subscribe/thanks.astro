---
import BaseLayout from '@/components/layout/BaseLayout.astro';
export const prerender = true;
---

<BaseLayout title="Terima kasih" description="Langganan kamu sudah aktif.">
  <section class="container thanks-page">
    <div class="thanks-card">
      <div class="icon">✓</div>
      <h1>Selamat datang!</h1>
      <p class="lead">Langganan kamu sudah aktif. Kamu akan mendapat email setiap kali ada cerita baru di Cerita Basim.</p>
      <div class="actions">
        <a href="/cerita" class="btn btn-primary">Baca cerita terbaru</a>
        <a href="/" class="btn btn-secondary">Kembali ke beranda</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: var(--container); margin: 0 auto; padding: 0 28px; }
  .thanks-page { min-height: 60vh; display: grid; place-items: center; padding: 56px 0; }
  .thanks-card { max-width: 480px; text-align: center; padding: 48px 36px; background: var(--paper); border: 1px solid var(--rule); border-radius: 14px; box-shadow: var(--shadow-md); }
  .icon { width: 72px; height: 72px; border-radius: 50%; background: linear-gradient(135deg, var(--accent), var(--accent-deep)); color: #fff; display: grid; place-items: center; margin: 0 auto 24px; font-size: 32px; font-weight: 800; }
  h1 { font-size: 32px; margin: 0 0 12px; }
  .lead { color: var(--ink-2); font-size: 16px; margin-bottom: 24px; }
  .actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; padding: 12px 20px; min-height: 44px; border-radius: 999px; font-size: 14.5px; font-weight: 600; text-decoration: none; border: 1px solid transparent; }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-secondary { background: var(--paper); color: var(--ink); border-color: var(--rule); }
</style>
