---
import BaseLayout from '@/components/layout/BaseLayout.astro';
export const prerender = true;
---

<BaseLayout title="Berhenti berlangganan">
  <section class="container unsub-page">
    <div class="unsub-card">
      <h1>Kamu sudah berhenti berlangganan.</h1>
      <p class="lead">Email kamu tidak akan menerima cerita baru lagi. Kalau berubah pikiran, kamu bisa subscribe ulang kapan saja.</p>
      <a href="/" class="btn btn-secondary">Kembali ke beranda</a>
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: var(--container); margin: 0 auto; padding: 0 28px; }
  .unsub-page { min-height: 60vh; display: grid; place-items: center; padding: 56px 0; }
  .unsub-card { max-width: 480px; text-align: center; padding: 48px 36px; background: var(--paper); border: 1px solid var(--rule); border-radius: 14px; }
  h1 { font-size: 28px; margin: 0 0 12px; }
  .lead { color: var(--ink-2); font-size: 16px; margin-bottom: 24px; }
  .btn { display: inline-flex; align-items: center; padding: 12px 20px; min-height: 44px; border-radius: 999px; font-size: 14.5px; font-weight: 600; text-decoration: none; border: 1px solid transparent; }
  .btn-secondary { background: var(--paper); color: var(--ink); border-color: var(--rule); }
</style>
