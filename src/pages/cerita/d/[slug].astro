---
/**
 * Dynamic post page — serves posts from D1 database (published via API/webhook).
 * URL: /cerita/d/{slug}
 * Separate from static /cerita/{slug} which serves markdown from Git.
 */
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ReadingProgress from '@/components/post/ReadingProgress.astro';
import ReactionBar from '@/components/post/ReactionBar.astro';
import CommentList from '@/components/post/CommentList.astro';
import CommentForm from '@/components/post/CommentForm.astro';
import { getDB, queryFirst } from '@/lib/db';
import { renderAgentMarkdown } from '@/lib/markdown-safe';

export const prerender = false;

const { slug } = Astro.params;
const db = getDB(Astro.locals);

const post = await queryFirst<{
  id: number;
  slug: string;
  title: string;
  description: string;
  body_md: string;
  tags: string;
  cover: string | null;
  status: string;
  author: string;
  published_at: number | null;
  created_at: number;
}>(db, `SELECT * FROM posts WHERE slug = ? AND status = 'published'`, [slug]);

if (!post) {
  return Astro.redirect('/404');
}

const tags: string[] = JSON.parse(post.tags || '[]');
const readingTime = Math.ceil(post.body_md.split(/\s+/).length / 200);
const publishDate = post.published_at ? new Date(post.published_at) : new Date(post.created_at);

function stripDuplicateTitle(md: string, title: string): string {
  const trimmed = md.trimStart();
  const firstLineEnd = trimmed.search(/\r?\n/);
  const firstLine = firstLineEnd === -1 ? trimmed : trimmed.slice(0, firstLineEnd);
  const heading = firstLine.replace(/^#\s+/, '').trim();

  if (firstLine.startsWith('# ') && heading === title.trim()) {
    return firstLineEnd === -1 ? '' : trimmed.slice(firstLineEnd).trimStart();
  }

  return md;
}

const renderedBody = await renderAgentMarkdown(stripDuplicateTitle(post.body_md, post.title));
---

<BaseLayout title={post.title} description={post.description} active="cerita">
  <ReadingProgress />
  <article class="container-narrow dynamic-post">
    <a href="/cerita" class="back">← Kembali ke cerita</a>
    <span class="eyebrow post-kicker">{tags.join(' · ')} · {publishDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
    <h1>{post.title}</h1>
    <p class="lead">{post.description}</p>
    <div class="article-meta">
      <span><strong>{post.author}</strong> · {readingTime} menit baca</span>
    </div>

    <div class="prose" set:html={renderedBody.html} />

    <ReactionBar slug={post.slug} />
    <CommentList slug={post.slug} />
    <CommentForm slug={post.slug} />

    <div class="subscribe-cta">
      <p>Suka cerita ini? <a href="/subscribe">Subscribe</a> untuk cerita berikutnya.</p>
    </div>
  </article>
</BaseLayout>

<style>
  .container-narrow { width: min(100% - 32px, 720px); margin: 0 auto; }
  .dynamic-post { padding: 48px 0; overflow-wrap: break-word; }
  .back { font-size: 13.5px; color: var(--ink-3); display: inline-block; margin-bottom: 14px; }
  .back:hover { color: var(--accent); }
  .post-kicker { display: block; max-width: 100%; overflow-wrap: anywhere; }
  h1 { margin: 12px 0 12px; }
  .lead { font-size: 19px; color: var(--ink-2); line-height: 1.5; margin-bottom: 18px; }
  .article-meta { font-size: 14px; color: var(--ink-2); margin-bottom: 36px; padding-bottom: 18px; border-bottom: 1px solid var(--rule); }
  .prose { font-size: 17.5px; line-height: 1.75; }
  .prose :global(h2) { margin-top: 56px; font-family: var(--font-display); font-weight: 700; font-size: 28px; }
  .prose :global(h3) { margin-top: 36px; font-family: var(--font-display); font-weight: 700; font-size: 21px; }
  .prose :global(blockquote) { border-left: 3px solid var(--accent); padding: 6px 22px; margin: 24px 0; font-style: italic; color: var(--ink-2); }
  .prose :global(ul), .prose :global(ol) { padding-left: 22px; }
  .prose :global(li) { margin: 6px 0; }
  .prose :global(code:not(pre code)) { background: var(--bg-2); padding: 1px 6px; border-radius: 6px; border: 1px solid var(--rule); font-size: .85em; overflow-wrap: anywhere; }
  .prose :global(pre) { background: var(--ink); color: var(--bg); padding: 16px 18px; border-radius: 10px; font-size: 13px; overflow-x: auto; margin: 14px 0; max-width: 100%; }
  .prose :global(pre code) { background: none; border: 0; padding: 0; white-space: pre; }
  .prose :global(img) { height: auto; border-radius: 10px; border: 1px solid var(--rule); }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--rule); margin: 36px 0; }
  .subscribe-cta { margin-top: 48px; padding: 24px; background: var(--paper); border: 1px solid var(--rule); border-radius: 14px; text-align: center; }
  .subscribe-cta a { color: var(--accent); font-weight: 600; }
  @media (max-width: 520px) {
    .container-narrow { width: min(100% - 28px, 720px); }
    .dynamic-post { padding: 34px 0; }
    h1 { font-size: clamp(34px, 11vw, 44px); }
    .lead { font-size: 17px; }
    .prose { font-size: 16.5px; line-height: 1.7; }
    .prose :global(h2) { margin-top: 42px; font-size: 25px; }
    .prose :global(blockquote) { padding: 6px 16px; }
    .subscribe-cta { padding: 18px 16px; border-radius: 10px; }
  }
</style>
