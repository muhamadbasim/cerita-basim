---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ReadingProgress from '@/components/post/ReadingProgress.astro';
import TableOfContents from '@/components/post/TableOfContents.astro';
import RelatedPosts from '@/components/post/RelatedPosts.astro';
import ReactionBar from '@/components/post/ReactionBar.astro';
import CommentList from '@/components/post/CommentList.astro';
import CommentForm from '@/components/post/CommentForm.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await post.render();

const readingTime = Math.ceil(post.body.split(/\s+/).length / 200);

// Prefer an explicit cover image; otherwise use the generated OG card for this post.
const ogImage = post.data.cover ?? `/og/cerita-${post.slug}.png`;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.publishedAt.toISOString(),
  "dateModified": (post.data.updatedAt || post.data.publishedAt).toISOString(),
  "author": { "@type": "Person", "name": "Basim", "url": "https://cerita.basim.id/tentang" },
  "publisher": { "@type": "Person", "name": "Basim", "url": "https://cerita.basim.id" },
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://cerita.basim.id/cerita/${post.slug}` },
  ...(post.data.cover ? { "image": `https://cerita.basim.id${post.data.cover}` } : {}),
  "wordCount": post.body.split(/\s+/).length,
  "inLanguage": "id",
});
---

<BaseLayout title={post.data.title} description={post.data.description} active="cerita" ogImage={ogImage}>
  <script type="application/ld+json" set:html={jsonLd} />
  <ReadingProgress />
  <div class="post-layout">
    <article class="post-content">
      <a href="/cerita" class="back">← Kembali ke cerita</a>
      <span class="eyebrow">{post.data.tags.join(' · ')} · {post.data.publishedAt.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <div class="article-meta">
        <span><strong>Basim</strong> · {readingTime} menit baca</span>
      </div>

      <div class="prose">
        <Content />
      </div>

      <ReactionBar slug={post.slug} />

      <CommentList slug={post.slug} />
      <CommentForm slug={post.slug} />

      <div class="subscribe-cta">
        <p>Suka cerita ini? <a href="/subscribe">Subscribe</a> untuk cerita berikutnya langsung ke email kamu.</p>
      </div>

      <div id="related-posts-sentinel" aria-hidden="true" style="height:1px;pointer-events:none;"></div>

      <RelatedPosts
        currentSlug={post.slug}
        currentTags={post.data.tags}
        allPosts={allPosts}
      />
    </article>
    <aside class="post-sidebar">
      <TableOfContents headings={headings} />
    </aside>
  </div>
</BaseLayout>

<style>
  .post-layout {
    max-width: var(--container);
    margin: 0 auto;
    padding: 48px 28px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 1000px) {
    .post-layout {
      grid-template-columns: 1fr 220px;
      gap: 48px;
    }
  }

  .post-content {
    max-width: var(--container-narrow);
    min-width: 0;
  }

  .post-sidebar {
    display: none;
  }

  @media (min-width: 1000px) {
    .post-sidebar {
      display: block;
    }
  }

  .back { font-size: 13.5px; color: var(--ink-3); display: inline-block; margin-bottom: 14px; }
  .back:hover { color: var(--accent); }
  h1 { margin: 12px 0 12px; }
  .lead { font-size: 19px; color: var(--ink-2); line-height: 1.5; margin-bottom: 18px; }
  .article-meta { font-size: 14px; color: var(--ink-2); margin-bottom: 36px; padding-bottom: 18px; border-bottom: 1px solid var(--rule); }
  .prose { font-size: 17.5px; line-height: 1.75; }
  .prose :global(h2) { margin-top: 56px; }
  .prose :global(h3) { margin-top: 36px; }
  .prose :global(blockquote) { border-left: 3px solid var(--accent); padding: 6px 22px; margin: 24px 0; font-family: var(--font-display); font-style: italic; font-size: 19px; color: var(--ink-2); }
  .prose :global(ul), .prose :global(ol) { padding-left: 22px; }
  .prose :global(li) { margin: 6px 0; }
  .prose :global(code:not(pre code)) { background: var(--bg-2); padding: 1px 6px; border-radius: 6px; border: 1px solid var(--rule); font-size: .85em; }
  .prose :global(pre) { background: var(--ink); color: var(--bg); padding: 16px 18px; border-radius: 10px; font-size: 13px; overflow-x: auto; margin: 14px 0; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--rule); margin: 36px 0; }
  .subscribe-cta { margin-top: 48px; padding: 24px; background: var(--paper); border: 1px solid var(--rule); border-radius: 14px; text-align: center; }
  .subscribe-cta a { color: var(--accent); font-weight: 600; border-bottom: 1px solid rgba(194,65,12,.3); }
</style>
