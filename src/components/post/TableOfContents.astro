---
/**
 * TableOfContents — sticky sidebar navigation for post headings.
 * Extracts h2/h3 headings from Astro's getHeadings() output,
 * generates anchor links, highlights current section via IntersectionObserver.
 * Sticky on desktop, hidden on mobile (<1000px).
 *
 * Validates: REQ-004 (Auto Table of Contents)
 */

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// Filter to only h2 and h3
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length > 0 && (
  <nav class="toc" aria-label="Daftar isi" id="table-of-contents">
    <p class="toc__title">Daftar Isi</p>
    <ul class="toc__list">
      {tocHeadings.map((heading) => (
        <li class={`toc__item toc__item--h${heading.depth}`}>
          <a
            href={`#${heading.slug}`}
            class="toc__link"
            data-slug={heading.slug}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    position: sticky;
    top: 96px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding: 20px 0;
    display: none;
  }

  @media (min-width: 1000px) {
    .toc {
      display: block;
    }
  }

  .toc__title {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 12px;
    padding-left: 14px;
    border-left: 2px solid var(--rule);
  }

  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc__item {
    margin: 0;
  }

  .toc__item--h3 {
    padding-left: 16px;
  }

  .toc__link {
    display: block;
    padding: 6px 14px;
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--ink-3);
    border-left: 2px solid transparent;
    transition: color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
    text-decoration: none;
  }

  .toc__link:hover {
    color: var(--ink);
  }

  .toc__link.active {
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 500;
  }
</style>

<script>
  function initTableOfContents() {
    const nav = document.getElementById('table-of-contents');
    if (!nav) return;

    const links = nav.querySelectorAll<HTMLAnchorElement>('.toc__link');
    if (links.length === 0) return;

    // Collect all heading elements referenced by the TOC
    const headingElements: HTMLElement[] = [];
    links.forEach((link) => {
      const slug = link.dataset.slug;
      if (slug) {
        const el = document.getElementById(slug);
        if (el) headingElements.push(el);
      }
    });

    if (headingElements.length === 0) return;

    let currentActiveSlug: string | null = null;

    function setActive(slug: string | null) {
      if (slug === currentActiveSlug) return;
      currentActiveSlug = slug;

      links.forEach((link) => {
        if (link.dataset.slug === slug) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }
      });
    }

    // Use IntersectionObserver to detect which heading is in view
    const observer = new IntersectionObserver(
      (entries) => {
        // Find the first heading that is intersecting (visible)
        // We track all visible headings and pick the topmost one
        const visibleEntries = entries.filter((e) => e.isIntersecting);

        if (visibleEntries.length > 0) {
          // Pick the one closest to the top of the viewport
          const topEntry = visibleEntries.reduce((closest, entry) => {
            return entry.boundingClientRect.top < closest.boundingClientRect.top
              ? entry
              : closest;
          });
          setActive(topEntry.target.id);
        }
      },
      {
        // rootMargin: negative top to trigger when heading is near top of viewport
        rootMargin: '-80px 0px -70% 0px',
        threshold: 0,
      }
    );

    headingElements.forEach((el) => observer.observe(el));

    // Cleanup on page transition
    document.addEventListener('astro:before-swap', () => {
      observer.disconnect();
    }, { once: true });
  }

  // Run on page load and on Astro page transitions
  document.addEventListener('astro:page-load', initTableOfContents);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTableOfContents);
  } else {
    initTableOfContents();
  }
</script>
