---
import '@/styles/global.css';

interface Props {
  title: string;
  active?: 'dashboard' | 'moderation' | 'subscribers' | 'dispatch' | 'review' | 'agents';
  pendingCount?: number;
  reviewCount?: number;
}
const { title, active, pendingCount = 0, reviewCount = 0 } = Astro.props;
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · Admin Cerita Basim</title>
  <meta name="robots" content="noindex,nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700;9..144,800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>
    (function(){try{const s=localStorage.getItem('cb-theme');if(s)document.documentElement.setAttribute('data-theme',s);else if(window.matchMedia('(prefers-color-scheme: dark)').matches)document.documentElement.setAttribute('data-theme','dark')}catch(e){}})();
  </script>
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-logo">
        <span class="brand-mark">cb</span>
        <span class="brand-name">Cerita <em>Basim</em></span>
      </div>
      <nav class="sidebar-nav" aria-label="Admin">
        <span class="sidebar-nav-section">Beranda</span>
        <a href="/admin/dashboard" class:list={[{ active: active === 'dashboard' }]}>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
          Dashboard
        </a>
        <span class="sidebar-nav-section">Konten</span>
        <a href="/admin/review" class:list={[{ active: active === 'review' }]}>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          Review {reviewCount > 0 && <span class="badge">{reviewCount}</span>}
        </a>
        <span class="sidebar-nav-section">Engagement</span>
        <a href="/admin/moderation" class:list={[{ active: active === 'moderation' }]}>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Moderasi {pendingCount > 0 && <span class="badge">{pendingCount}</span>}
        </a>
        <a href="/admin/subscribers" class:list={[{ active: active === 'subscribers' }]}>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          Subscriber
        </a>
        <a href="/admin/dispatch" class:list={[{ active: active === 'dispatch' }]}>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          Dispatch
        </a>
        <span class="sidebar-nav-section">Sistem</span>
        <a href="/admin/agents" class:list={[{ active: active === 'agents' }]}>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1.27A7 7 0 0 1 14 22h-4a7 7 0 0 1-6.73-3H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/></svg>
          Agents
        </a>
        <span class="sidebar-nav-section">Lain</span>
        <a href="/" target="_blank">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M14 10l7-7M9 21H3v-6M10 14l-7 7"/></svg>
          Lihat situs
        </a>
        <a href="/cdn-cgi/access/logout">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
          Keluar
        </a>
      </nav>
      <div class="sidebar-footer">
        <div class="avatar">B</div>
        <div>
          <div style="font-weight: 600; color: var(--ink); font-size: 13.5px;">Basim</div>
          <div style="font-size: 11.5px; color: var(--ink-3);">Admin</div>
        </div>
      </div>
    </aside>

    <main class="app-main">
      <slot />
    </main>
  </div>

  <div class="toast-region" id="toasts" aria-live="polite"></div>
</body>
</html>

<style>
  .app-shell { display: grid; grid-template-columns: 256px 1fr; min-height: 100vh; }
  @media (max-width: 900px) { .app-shell { grid-template-columns: 1fr; } .sidebar { display: none; } }
  .sidebar { position: sticky; top: 0; height: 100vh; background: var(--paper); border-right: 1px solid var(--rule); display: flex; flex-direction: column; padding: 20px 16px; }
  .sidebar-logo { display: flex; align-items: center; gap: 12px; padding: 0 8px 24px; border-bottom: 1px solid var(--rule); margin-bottom: 16px; }
  .sidebar-logo .brand-mark { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 10px; background: linear-gradient(135deg, var(--accent), var(--accent-deep)); color: #fff; font-family: var(--font-display); font-weight: 800; font-size: 16px; }
  .sidebar-logo .brand-name { font-family: var(--font-display); font-weight: 700; font-size: 17px; }
  .sidebar-logo .brand-name em { font-style: italic; color: var(--accent-2); font-weight: 500; }
  .sidebar-nav { display: flex; flex-direction: column; gap: 2px; flex: 1; }
  .sidebar-nav-section { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); padding: 18px 12px 6px; }
  .sidebar-nav a { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 10px; color: var(--ink-2); font-size: 14.5px; font-weight: 500; min-height: 44px; transition: background 200ms, color 200ms; text-decoration: none; }
  .sidebar-nav a:hover { background: var(--bg-2); color: var(--ink); }
  .sidebar-nav a.active { background: var(--ink); color: var(--bg); }
  .sidebar-nav .nav-icon { width: 18px; height: 18px; flex-shrink: 0; }
  .sidebar-nav .badge { margin-left: auto; background: var(--accent); color: #fff; font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 999px; }
  .sidebar-footer { padding: 12px; border-top: 1px solid var(--rule); display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--ink-2); }
  .sidebar-footer .avatar { width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, var(--accent-2), var(--accent-2-deep)); color: #fff; display: grid; place-items: center; font-family: var(--font-display); font-weight: 700; font-size: 13px; }
  .app-main { padding: 32px 36px; min-width: 0; }
  @media (max-width: 720px) { .app-main { padding: 24px 20px; } }
  .toast-region { position: fixed; bottom: 24px; right: 24px; z-index: 900; display: flex; flex-direction: column; gap: 8px; }
</style>
