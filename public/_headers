# Cloudflare Pages headers — security + caching.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  X-DNS-Prefetch-Control: on
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://cerita.basim.id https://imagedelivery.net https://*.r2.cloudflarestorage.com; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; upgrade-insecure-requests

# Admin surface — never index, never cache.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/api/*
  Cache-Control: no-store

# Fingerprinted build assets are immutable — cache hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Social cards and static art — cache a day, allow revalidation.
/og/*
  Cache-Control: public, max-age=86400
/og-default.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
